.build/
.swiftpm/
# Per-user Xcode state only. A bare `*.xcodeproj` would exclude
# Examples/TongueExample, whose project file is checked in on purpose (emo does the
# same) — without it there is no iOS app to open.
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
.DS_Store
build/
node_modules/
dist/
packages/tongue-kotlin/build/
packages/tongue-js/package-lock.json

# `swift package edit` writes a checkout under Packages/. On a case-insensitive
# filesystem git also matches ignore rules case-insensitively, so a bare
# `/Packages/` silently ignores our own packages/ tree — which is how the Gradle
# wrapper went missing. Name the checkout instead; it cannot collide with a real
# file because our packages are tongue-js and tongue-kotlin.
packages/desert-ant-core
.gradle/
Examples/*/.build/
Examples/*/build/
Examples/*/.gradle/
# The examples resolve against the package next to them; the root Package.resolved
# is the one that pins anything.
Examples/*/Package.resolved
