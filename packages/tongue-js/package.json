{
  "name": "@desert-ant-labs/tongue",
  "version": "0.1.0",
  "description": "On-device language identification for short text, across 83 languages. Pure JavaScript: no wasm, no inference runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && cp src/tongue_int8.bin src/tongue_meta.json dist/",
    "test": "npm run build && node --test test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "language-identification", "language-detection", "langid",
    "on-device", "offline", "multilingual", "typescript", "browser"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Desert-Ant-Labs/tongue.git",
    "directory": "packages/tongue-js"
  },
  "homepage": "https://desertant.com/models/tongue/",
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "devDependencies": { "@types/node": "^22", "typescript": "^5" }
}
